        {% if file_info.binary_or_files %}timeout: float | httpx.Timeout | None = None,{% endif %}
        {% endif %}
    ) {% if file_info.binary_response %} -> AsyncIterator[httpx.Response] {% elif response_type != "" %} -> {{ response_type }} {% endif %}:
        {% if docs %}"""{{ docs }}"""{% endif %}
        
        url = "{{ url_template }}".format(self.client.base_url{% for arg in args %}{% if arg.in_url %}, {{ arg.name }}={{ arg.name }}{% endif %}{% endfor %})
        
        {% for arg in args %}
        {% if arg.in_query %}
        if {{ arg.name }} is not None:
            url = str(httpx.URL(url).copy_add_param("{{ arg.name }}", {% if arg.is_csv %}",".join(str(value) for value in {{ arg.name }}){% elif "datetime" in arg.type %}{{ arg.name }}.isoformat(){% elif "bool" in arg.type %}str({{ arg.name }}).lower(){% else %}str({{ arg.name }}){% endif %}))
        {% endif %}
        {% endfor %}

        _client = self.client.get_http_client()
        {% set header_args = args|selectattr("header_name")|list %}
        {% if header_args or file_info.binary_or_files or file_info.has_json_body_multipart %}
        headers = httpx.Headers(self.client.get_headers())
        {% if header_args and has_request_body and request_body_type != "bytes" and not file_info.has_json_body_multipart %}
        headers.setdefault("Content-Type", "application/json")
        {% endif %}
        {% for arg in header_args %}
        {% if arg.is_optional %}if {{ arg.name }} is not None:
            {% endif %}headers["{{ arg.header_name }}"] = str({{ arg.name }})
        {% endfor %}
        {% endif %}
        {% if file_info.binary_response %}
        async with _client.stream("{{ method|upper }}", url, headers={% if header_args %}headers{% else %}self.client.get_headers(){% endif %}) as response:
            if not response.is_success:
                await response.aread()
                raise_for_status(response)
            yield response
        {% else %}
        {% if file_info.binary_or_files %}
        request_timeout = _client.timeout if timeout is None else timeout
        if isinstance(body, Mapping):
            headers.pop("Content-Type", None)
            files = [("files", (path, content, "application/octet-stream")) for path, content in body.items()]
            response = await _client.{{ method }}(url, files=files, headers=headers, timeout=request_timeout)
        else:
            headers["Content-Type"] = "application/octet-stream"
            response = await _client.{{ method }}(url, content=body, headers=headers, timeout=request_timeout)
        {% elif file_info.has_json_body_multipart %}
        {% if file_info.requires_file_attachments %}
        if not file_attachments:
            raise ValueError("At least one file attachment is required")
        {% endif %}
        headers.pop("Content-Type", None)
        response = await upload_json_multipart_async(
            client=_client,
            url=url,
            method="{{ method|upper }}",
            json_body=body,
            filenames_from_keys={{ file_info.filenames_from_keys }},
            file_attachments=file_attachments,
            headers=headers,
        )
        {% else %}
        response = await _client.{{ method }}(
            url=url,
            headers={% if header_args %}headers{% else %}self.client.get_headers(){% endif %},
            {% if has_request_body %}{% if request_body_type != "bytes" %}content=serialize_request_body(body),{% else %}content=body,{% endif %}{% endif %}
        )
        {% endif %}

        if not response.is_success:
            from kittycad.response_helpers import raise_for_status
            raise_for_status(response)
        
        {% if response_type and response_type != "" %}
        if not response.content:
            return None  # type: ignore
            
        json_data = response.json()
        {% if response_type.startswith('Union') or response_type.startswith('Optional[Union') or response_type.startswith('Dict') or response_type.startswith('List') or response_type.startswith('dict') or response_type.startswith('list') %}
        # Validate into annotated/collection/union types using TypeAdapter
